<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFFFF"
            android:lineSpacingExtra="6dp"
            android:padding="14dp"
            android:text="正在读取状态…"
            android:textColor="#FF1F2937"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_login" />

        <Button
            android:id="@+id/btnAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_accounts" />

        <Button
            android:id="@+id/btnCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="签到日历" />

        <Button
            android:id="@+id/btnLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_loc" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_refresh" />

        <Button
            android:id="@+id/btnSign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_sign" />

        <Button
            android:id="@+id/btnNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_net" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_title"
                    android:textColor="#FF1F2937"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScheduleSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/schedule_off_hint"
                    android:textColor="#FF6B7280"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_time" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sec_auth"
            android:textColor="#FF6B7280"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNoti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_noti" />

        <Button
            android:id="@+id/btnAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_alarm" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_battery" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sec_tools"
            android:textColor="#FF6B7280"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_cache" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_log" />

        <Button
            android:id="@+id/btnExportLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_export_log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sec_log"
            android:textColor="#FF6B7280"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF111827"
            android:fontFamily="monospace"
            android:minHeight="180dp"
            android:padding="10dp"
            android:textColor="#FFB9F6CA"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
